<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Package visibility, mandatory from API 30: without this, resolveActivity() reports that no
        application handles geo: even when Google Maps is installed, so every shared location would
        silently fall back to the browser.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="geo" />
        </intent>

        <!--
            Same rule, same consequence, for an attached link. Browsers are NOT on the automatic
            visibility list, so without this resolveActivity() reports that nothing handles https
            and every link Yo receives is dropped before it can be made tappable - the sender sees
            it attached, the recipient gets a plain Yo. Robolectric does not enforce visibility
            filtering, so no unit test can catch its absence.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>

        <!--
            Named explicitly because a shared location is sent to Google Maps by package rather
            than left to a chooser: on a real handset six applications claim geo:, and "open with"
            is not an answer to "here is where I am".
        -->
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".YoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Yo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yo">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.YoFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
